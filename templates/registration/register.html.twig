{% extends 'base.html.twig' %}

{% block title %}إنشاء حساب{% endblock %}

{% block body %}
    <div dir="rtl" class="flex min-h-screen items-center justify-center px-5 py-12 sm:px-8">
        <section class="w-full max-w-xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <p class="mb-2 text-sm font-semibold text-indigo-600">Vekas EMP</p>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900">إنشاء حساب جديد</h1>
            <p class="mt-2 text-sm text-slate-500">أدخل بياناتك لإنشاء حساب لإدارة الموظفين.</p>

            <div class="mt-6 space-y-4">
                {{ form_errors(registrationForm) }}
                {{ form_start(registrationForm, {'attr': {'class': 'space-y-5'}}) }}
                    {{ form_row(registrationForm.username, {
                        label: 'اسم المستخدم',
                        row_attr: {class: 'space-y-2'},
                        label_attr: {class: 'block text-sm font-semibold text-slate-700'},
                        attr: {class: 'w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100'}
                    }) }}
                    {{ form_row(registrationForm.plainPassword, {
                        label: 'كلمة المرور',
                        row_attr: {class: 'space-y-2'},
                        label_attr: {class: 'block text-sm font-semibold text-slate-700'},
                        attr: {class: 'w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100'}
                    }) }}
                    {{ form_row(registrationForm.agreeTerms, {
                        label: 'أوافق على الشروط',
                        row_attr: {class: 'flex items-center gap-3 text-sm text-slate-600'},
                        attr: {class: 'size-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500'}
                    }) }}
                    <button type="submit" class="w-full rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100">إنشاء الحساب</button>
                {{ form_end(registrationForm) }}
            </div>
        </section>
    </div>
{% endblock %}
