{{ form_start(form) }}
    <div class="flex flex-col w-80">
        {{ form_label(form.day,"day") }}
        {{ form_widget(form.day,{
            attr:{
                class:"mb-4 w-full bg-transparent placeholder:text-slate-400 text-slate-700 text-sm border border-slate-200 rounded pl-3 pr-8 py-2 transition duration-300 ease focus:outline-none focus:border-slate-400 hover:border-slate-400 shadow-sm focus:shadow-md appearance-none cursor-pointer"
            }
        }) }}
        <button class="btn py-3 px-4 bg-sky-900 text-sky-200 font-semibold">{{ button_label|default('Save') }}</button>
    </div>
{{ form_end(form) }}
