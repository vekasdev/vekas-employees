{{ form_start(form, {'attr': {'dir': 'rtl', 'class': 'space-y-5'}}) }}
    <div class="space-y-2">
        {{ form_label(form.day, 'اليوم', {'label_attr': {'class': 'block text-sm font-semibold text-slate-700'}}) }}
        {{ form_widget(form.day,{
            attr:{
                class:"w-full cursor-pointer appearance-none rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"
            }
        }) }}
    </div>
    <button class="w-full cursor-pointer rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100">{{ button_label|default('حفظ اليوم') }}</button>
{{ form_end(form) }}
