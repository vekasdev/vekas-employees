{% extends 'base.html.twig' %}

{% block title %}تفاصيل يوم العطلة{% endblock %}

{% block body %}
    <div dir="rtl" class="mx-auto max-w-3xl space-y-6">
        <header>
            <p class="mb-2 text-sm font-semibold text-indigo-600">إعدادات الدوام</p>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900">تفاصيل يوم العطلة</h1>
        </header>

        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
            <dl class="space-y-4">
                <div>
                    <dt class="text-sm font-medium text-slate-500">رقم السجل</dt>
                    <dd class="mt-1 text-base font-semibold text-slate-900">#{{ weekly_day_off.id }}</dd>
                </div>
                <div class="border-t border-slate-100 pt-4">
                    <dt class="text-sm font-medium text-slate-500">اليوم</dt>
                    <dd class="mt-1 text-base font-semibold text-slate-900">{{ weekly_day_off.day.value }}</dd>
                </div>
            </dl>
        </section>

        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
            {{ include('weekly_day_off/_delete_form.html.twig') }}
            <div class="flex items-center gap-4">
                <a href="{{ path('app_weekly_day_off_edit', {'id': weekly_day_off.id}) }}" class="text-sm font-semibold text-indigo-700 transition hover:text-indigo-900">تعديل</a>
                <a href="{{ path('app_weekly_day_off_index') }}" class="text-sm font-semibold text-slate-600 transition hover:text-indigo-700">العودة إلى القائمة</a>
            </div>
        </div>
    </div>
{% endblock %}
