{% extends 'base.html.twig' %}

{% block title %}العطل الأسبوعية{% endblock %}

{% block body %}
    <div dir="rtl" class="mx-auto w-full max-w-5xl space-y-6">
        <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="mb-2 text-sm font-semibold text-indigo-600">إعدادات الدوام</p>
                <h1 class="text-3xl font-bold tracking-tight text-slate-900">العطل الأسبوعية</h1>
                <p class="mt-2 text-sm text-slate-500">الأيام التي لا يُحتسب فيها غياب الموظفين.</p>
            </div>
            <a href="{{ path('app_weekly_day_off_new') }}" class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m7-7H5" />
                </svg>
                إضافة يوم عطلة
            </a>
        </header>

        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
                <h2 class="text-lg font-bold text-slate-900">الأيام المسجلة</h2>
                <span class="text-sm text-slate-500">{{ weekly_day_offs|length }} أيام</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[480px] text-right text-sm">
                    <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
                        <tr>
                            <th scope="col" class="px-5 py-3">رقم</th>
                            <th scope="col" class="px-5 py-3">اليوم</th>
                            <th scope="col" class="px-5 py-3">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                    {% for weekly_day_off in weekly_day_offs %}
                        <tr class="transition hover:bg-slate-50">
                            <td class="px-5 py-4 font-medium text-slate-500">#{{ weekly_day_off.id }}</td>
                            <td class="px-5 py-4 font-semibold text-slate-900">{{ weekly_day_off.day.value }}</td>
                            <td class="px-5 py-4">
                                <a href="{{ path('app_weekly_day_off_delete', {'id': weekly_day_off.id}) }}" onclick="return confirm('هل أنت متأكد من حذف يوم العطلة؟');" class="rounded-lg px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-50">حذف</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="px-5 py-12 text-center text-slate-500">لم تتم إضافة أيام عطلة بعد</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
{% endblock %}
