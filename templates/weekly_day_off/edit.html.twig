{% extends 'base.html.twig' %}

{% block title %}Edit WeeklyDayOff{% endblock %}

{% block body %}
    <div dir="rtl" class="mx-auto max-w-xl space-y-6">
        <header>
            <p class="mb-2 text-sm font-semibold text-indigo-600">إعدادات الدوام</p>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900">تعديل يوم العطلة</h1>
            <p class="mt-2 text-sm text-slate-500">{{ weekly_day_off.day.value }}</p>
        </header>
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
            {{ include('weekly_day_off/_form.html.twig', {'button_label': 'حفظ التعديلات'}) }}
        </section>
        <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
            {{ include('weekly_day_off/_delete_form.html.twig') }}
            <a href="{{ path('app_weekly_day_off_index') }}" class="text-sm font-semibold text-slate-600 transition hover:text-indigo-700">العودة إلى العطل الأسبوعية</a>
        </div>
    </div>
{% endblock %}
