<form method="post" action="{{ path('app_weekly_day_off_delete', {'id': weekly_day_off.id}) }}" onsubmit="return confirm('هل أنت متأكد من حذف يوم العطلة؟');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ weekly_day_off.id) }}">
    <button class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:border-rose-300 hover:bg-rose-100 focus:outline-none focus:ring-4 focus:ring-rose-100">حذف يوم العطلة</button>
</form>
