{{ form_start(form) }}
    <div class="text-right">
           <div class="my-4">
            {{
                form_label(form.checkIn,'وقت الحضور',{
                    "label_attr" : {
                        'class' : "mb-3 block"
                    }
                })
            }}

            {{
                form_widget(form.checkIn,{
                    "attr" : {
                        'class' : "w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                    }
                })
            }}
        </div>

        <div class="my-4">
            {{
                form_label(form.checkOut,'وقت الانصراف',{
                    "label_attr" : {
                        'class' : "mb-3 block"
                    }
                })
            }}

            {{
                form_widget(form.checkOut,{
                    "attr" : {
                        'class' : "w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                    }
                })
            }}
         </div>
     <button class=" cursor-pointer btn w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 bg-green-900 text-gray-50">حفظ</button>
    </div>
{{ form_end(form) }}
