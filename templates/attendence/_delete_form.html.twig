<form method="post" action="{{ path('app_attendence_delete', {'id': attendence.id}) }}" onsubmit="return confirm('هل أنت متأكد من حذف سجل الحضور؟');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ attendence.id) }}">
    <button class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:border-rose-300 hover:bg-rose-100 focus:outline-none focus:ring-4 focus:ring-rose-100">حذف السجل</button>
</form>
