{% extends 'base.html.twig' %}

{% block title %}Attendence{% endblock %}

{% block body %}
    <h1>Attendence</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ attendence.id }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ attendence.date ? attendence.date|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>CheckIn</th>
                <td>{{ attendence.checkIn ? attendence.checkIn|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>CheckOut</th>
                <td>{{ attendence.checkOut ? attendence.checkOut|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_attendence_index') }}">back to list</a>

    <a href="{{ path('app_attendence_edit', {'id': attendence.id}) }}">edit</a>

    {{ include('attendence/_delete_form.html.twig') }}
{% endblock %}
