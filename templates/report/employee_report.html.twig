{% extends 'base.html.twig' %}

{% block title %}تقرير الموظف{% endblock %}

{% macro dayOffToggle(employee, date, isDayOff) %}
    {% set dateLabel = date|date('Y-m-d', 'Asia/Baghdad') %}
    <form method="post" action="{{ path('day_off_toggle', {'id': employee.id, 'date': dateLabel}) }}" class="inline-block">
        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ employee.id ~ '-' ~ dateLabel) }}">
        {% if isDayOff %}
            <button type="submit"
                    aria-label="إزالة يوم العطلة {{ dateLabel }}"
                    title="إزالة يوم العطلة"
                    class="inline-flex items-center justify-center gap-2 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold text-rose-700 transition hover:border-rose-300 hover:bg-rose-100 focus:outline-none focus:ring-4 focus:ring-rose-100">
                إزالة يوم العطلة
            </button>
        {% else %}
            <button type="submit"
                    aria-label="إضافة يوم عطلة {{ dateLabel }}"
                    title="إضافة يوم عطلة"
                    class="inline-flex items-center justify-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-800 transition hover:border-amber-300 hover:bg-amber-100 focus:outline-none focus:ring-4 focus:ring-amber-100">
                إضافة يوم عطلة
            </button>
        {% endif %}
    </form>
{% endmacro %}

{% block body %}
    {% set commitmentPercentage = getCommitmentPercentage(employee, from, to) %}

    <div dir="rtl" class="mx-auto w-full max-w-7xl space-y-8 px-2 py-6 sm:px-4 lg:px-6">
        <header class="flex flex-col gap-4 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="mb-2 text-sm font-semibold text-indigo-600">تقارير الموظفين</p>
                <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">تقرير الموظف</h1>
                <p class="mt-2 text-base text-slate-500">{{ employee.firstName }} {{ employee.lastName }}</p>
            </div>
            <div class="inline-flex w-fit items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 text-indigo-600" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 3v3m8-3v3M4 9h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" />
                </svg>
                <span>{{ from|date('F Y') }}</span>
            </div>
        </header>

        <section aria-label="ملخص الحضور" class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-slate-500">إجمالي ساعات العمل</p>
                        <p class="mt-4 text-3xl font-bold tracking-tight text-slate-900">{{ getTotalWorkingHours(employee)|number_format(2) }}</p>
                    </div>
                    <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2" />
                        </svg>
                    </span>
                </div>
                <p class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">كل الوقت</p>
            </article>

            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-slate-500">إجمالي الغيابات</p>
                        <p class="mt-4 text-3xl font-bold tracking-tight text-slate-900">{{ getAbsentDays(employee, from, to) }}</p>
                    </div>
                    <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-rose-50 text-rose-600">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 3v3m8-3v3M4 9h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" />
                            <path stroke-linecap="round" d="m9 13 6 6m0-6-6 6" />
                        </svg>
                    </span>
                </div>
                <p class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">{{ from|date('F Y') }}</p>
            </article>

            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-slate-500">نسبة الالتزام</p>
                        <p class="mt-4 text-3xl font-bold tracking-tight text-slate-900">{{ commitmentPercentage|number_format(1) }}%</p>
                    </div>
                    <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3v18h18M7 14v4m5-8v8m5-12v12" />
                        </svg>
                    </span>
                </div>
                <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-slate-100">
                    <div class="h-full rounded-full bg-emerald-500 transition-all" style="width: {{ commitmentPercentage }}%"></div>
                </div>
                <p class="mt-2 text-xs text-slate-500">{{ from|date('F Y') }}</p>
            </article>

            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-sm font-medium text-slate-500">عدد أيام التأخير</p>
                        <p class="mt-4 text-3xl font-bold tracking-tight text-slate-900">{{ getLateDays(employee, from, to) }}</p>
                    </div>
                    <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5m0 4h.01" />
                        </svg>
                    </span>
                </div>
                <p class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">{{ from|date('F Y') }}</p>
            </article>
        </section>

        <section aria-labelledby="attendance-details-title" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-col gap-1 border-b border-slate-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                <h2 id="attendance-details-title" class="text-lg font-bold text-slate-900">تفاصيل الحضور</h2>
                <p class="text-sm text-slate-500">{{ from|date('Y/m/d') }} — {{ to|date('Y/m/d') }}</p>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-[840px] w-full text-right text-sm">
                    <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
                        <tr>
                            <th scope="col" class="whitespace-nowrap px-5 py-3">اليوم</th>
                            <th scope="col" class="whitespace-nowrap px-5 py-3">التاريخ</th>
                            <th scope="col" class="whitespace-nowrap px-5 py-3">يوم عطلة</th>
                            <th scope="col" class="whitespace-nowrap px-5 py-3">وقت الحضور</th>
                            <th scope="col" class="whitespace-nowrap px-5 py-3">وقت الانصراف</th>
                            <th scope="col" class="whitespace-nowrap px-5 py-3">ساعات العمل</th>
                            <th scope="col" class="whitespace-nowrap px-5 py-3">التأخير</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                    {% for day in days %}
                        {% set attendance = day.attendence %}
                        {% set isComplete = attendance is not null and attendance.checkIn is not null and attendance.checkOut is not null and attendance.isCompleted() %}
                        {% set isPassed = day.isPassed() %}
                        {% set isDayOff = employee.isDayOff(day.date) %}
                        {% set isLate = isAttendenceLate(attendance) %}

                        {% if isDayOff %}
                            <tr class="bg-amber-50/70 text-slate-600">
                                <td class="whitespace-nowrap px-5 py-4">{{ day.date.format('l') }}</td>
                                <td dir="ltr" class="whitespace-nowrap px-5 py-4 text-right">{{ day.date|date('Y-m-d', 'Asia/Baghdad') }}</td>
                                <td class="whitespace-nowrap px-5 py-4">{{ _self.dayOffToggle(employee, day.date, true) }}</td>
                                <td colspan="4" class="px-5 py-4">
                                    <span class="inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">يوم عطلة</span>
                                </td>
                            </tr>
                        {% elseif isPassed %}
                            <tr class="{{ isComplete ? 'bg-white' : 'bg-rose-50/60' }} transition-colors hover:bg-slate-50">
                                <td class="whitespace-nowrap px-5 py-4 font-medium text-slate-700">{{ day.date.format('l') }}</td>
                                <td dir="ltr" class="whitespace-nowrap px-5 py-4 text-right text-slate-500">{{ day.date|date('Y-m-d', 'Asia/Baghdad') }}</td>
                                <td class="whitespace-nowrap px-5 py-4">{{ _self.dayOffToggle(employee, day.date, false) }}</td>
                                <td dir="ltr" class="whitespace-nowrap px-5 py-4 text-right">
                                    {% if attendance and attendance.checkIn %}
                                        <span class="font-medium text-slate-700">{{ attendance.checkIn|date('h:i:s A', 'Asia/Baghdad') }}</span>
                                    {% else %}
                                        <span class="inline-flex rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-700">غائب</span>
                                    {% endif %}
                                </td>
                                <td dir="ltr" class="whitespace-nowrap px-5 py-4 text-right">
                                    {% if attendance and attendance.checkOut %}
                                        <span class="font-medium text-slate-700">{{ attendance.checkOut|date('h:i:s A', 'Asia/Baghdad') }}</span>
                                    {% else %}
                                        <span class="text-slate-400">—</span>
                                    {% endif %}
                                </td>
                                <td class="whitespace-nowrap px-5 py-4 text-slate-600">
                                    {{ attendance and attendance.checkOut ? attendance.workingHours|number_format(2) : '—' }}
                                </td>
                                <td class="whitespace-nowrap px-5 py-4">
                                    {% if isLate %}
                                        <span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">متأخر</span>
                                    {% else %}
                                        <span class="text-slate-400">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr class="bg-slate-50/70 text-slate-400">
                                <td class="whitespace-nowrap px-5 py-4">{{ day.date.format('l') }}</td>
                                <td dir="ltr" class="whitespace-nowrap px-5 py-4 text-right">{{ day.date|date('Y-m-d', 'Asia/Baghdad') }}</td>
                                <td class="whitespace-nowrap px-5 py-4">{{ _self.dayOffToggle(employee, day.date, false) }}</td>
                                <td colspan="4" class="px-5 py-4 text-slate-400">لم يحن الموعد</td>
                            </tr>
                        {% endif %}
                    {% else %}
                        <tr>
                            <td colspan="7" class="px-5 py-12 text-center text-slate-500">لا توجد بيانات لهذا الشهر</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
{% endblock %}
