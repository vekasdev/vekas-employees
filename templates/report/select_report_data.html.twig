{% extends 'base.html.twig' %}

{% block title %}اختيار فترة التقرير{% endblock %}

{% block body %}
    <div dir="rtl" class="mx-auto max-w-2xl space-y-6">
        <header>
            <p class="mb-2 text-sm font-semibold text-indigo-600">تقارير الموظفين</p>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900">اختيار فترة التقرير</h1>
            <p class="mt-2 text-sm text-slate-500">حدد السنة والشهر لعرض تقرير الموظف.</p>
        </header>

        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
            {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}
                <div class="space-y-2">
                    {{ form_label(form.years, 'السنة', {'label_attr': {'class': 'block text-sm font-semibold text-slate-700'}}) }}
                    {{ form_widget(form.years, {'attr': {'class': 'w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100'}}) }}
                    {{ form_errors(form.years) }}
                </div>
                <div class="space-y-2">
                    {{ form_label(form.months, 'الشهر', {'label_attr': {'class': 'block text-sm font-semibold text-slate-700'}}) }}
                    {{ form_widget(form.months, {'attr': {'class': 'w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100'}}) }}
                    {{ form_errors(form.months) }}
                </div>
                <button type="submit" class="w-full rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-100">عرض التقرير</button>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
