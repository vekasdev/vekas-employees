{% extends 'base.html.twig' %}

{% block title %}Edit Employee{% endblock %}

{% block body %}
    <div dir="rtl" class="mx-auto max-w-3xl space-y-6">
        <header>
            <p class="mb-2 text-sm font-semibold text-indigo-600">إدارة الموظفين</p>
            <h1 class="text-3xl font-bold tracking-tight text-slate-900">تعديل بيانات الموظف</h1>
            <p class="mt-2 text-sm text-slate-500">{{ employee.firstName }} {{ employee.lastName }}</p>
        </header>

        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
            {{ include('employee/_form.html.twig', {'button_label': 'حفظ التعديلات'}) }}
        </section>

        <section class="flex flex-col gap-4 rounded-2xl border border-rose-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h2 class="font-semibold text-slate-900">حذف الموظف</h2>
                <p class="mt-1 text-sm text-slate-500">سيتم حذف سجل الموظف وبياناته المرتبطة به.</p>
            </div>
            <div class="w-full sm:w-40">
                {{ include('employee/_delete_form.html.twig') }}
            </div>
        </section>
    </div>
{% endblock %}
