{% extends 'base.html.twig' %}

{% block title %}Employee{% endblock %}

{% block body %}
    <h1>Employee</h1>

    <table class="text-amber-600">
        <thead>
            <tr>
                <td class="text-8xl bg-yellow-900">رقم الموظف</td>
                <td>الاسم</td>
                <td>الحالة</td>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{{ employee.employeeNumber }}</td>
                <td>{{ employee.firstName ~ employee.lastName }}</td>
                <td class="bg-amber-950">متواجد</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_employee_index') }}">back to list</a>

    <a href="{{ path('app_employee_edit', {'id': employee.id}) }}">edit</a>

    {{ include('employee/_delete_form.html.twig') }}
{% endblock %}
