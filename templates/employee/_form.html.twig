                        'class' : "block text-sm font-semibold text-slate-700"
                    }
                })
            }}

            {{
                form_widget(form.lastName,{
                    "attr" : {
                        'class' : "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"
