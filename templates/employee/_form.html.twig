{{ form_start(form) }}
    <div class="text-right">
        <div class="my-4">
            {{
                form_label(form.firstName,'الاسم الاول',{
                    "label_attr" : {
                        'class' : "mb-3 block"
                    }
                })
            }}

            {{
                form_widget(form.firstName,{
                    "attr" : {
                        'class' : "w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                    }
                })
            }}
        </div>

        <div class="my-4">
            {{
                form_label(form.lastName,'الاسم الثاني',{
                    "label_attr" : {
                        'class' : "mb-3 block"
                    }
                })
            }}

            {{
                form_widget(form.lastName,{
                    "attr" : {
                        'class' : "w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                    }
                })
            }}
        </div>

        <div class="my-4">
       
            {{
                form_widget(form.submit,{
                'attr' : {
                    'class' : 'w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 bg-green-900 text-gray-50'
                }
                })
            }}
        </div>

    </div>
{{ form_end(form) }}
