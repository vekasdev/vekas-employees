<form method="post" class="w-full" action="{{ path('app_employee_delete', {'id': employee.id}) }}" onsubmit="return confirm('هل أنت متأكد من حذف هذا الموظف؟');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ employee.id) }}">
    <button class="w-full rounded-xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:border-rose-300 hover:bg-rose-100 focus:outline-none focus:ring-4 focus:ring-rose-100">حذف الموظف</button>
</form>
