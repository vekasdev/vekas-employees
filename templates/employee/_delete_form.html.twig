<form method="post" class="w-full" action="{{ path('app_employee_delete', {'id': employee.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ employee.id) }}">
    <button class="btn w-full py-2 px-6 bg-red-900 bg-gray-50 rounded-md text-gray-50">حذف</button>
</form>
